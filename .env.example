# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase PostgreSQL — sole persistent database (Project Settings → Database)
# URL-encode special characters in the password (e.g. . → %2E, @ → %40)
#
# Transaction pooler — app runtime (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Session pooler — Prisma migrations (port 5432, same pooler host, NOT db.*.supabase.co on IPv4-only networks)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Local Supabase only (`npm run supabase:start` → `npm run supabase:status`)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Liveblocks (https://liveblocks.io/dashboard) — realtime canvas, not the database
LIVEBLOCKS_SECRET_KEY=
