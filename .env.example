# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Keep auth on your app (not *.accounts.dev) — also set Paths in Clerk Dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/editor
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/editor

# Supabase PostgreSQL — sole persistent database (Project Settings → Database)
# URL-encode special characters in the password (e.g. . → %2E, @ → %40)
#
# Transaction pooler — app runtime (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Session pooler — Prisma migrations (port 5432, same pooler host, NOT db.*.supabase.co on IPv4-only networks)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Optional: enforce strict TLS verification (default: relaxed for Supabase pooler / Windows)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Alternative in URL only: append sslmode=no-verify instead of sslmode=require

# Local Supabase only (`npm run supabase:start` → `npm run supabase:status`)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Liveblocks (https://liveblocks.io/dashboard) — realtime canvas, not the database
LIVEBLOCKS_SECRET_KEY=sk_dev_0gODecFLzrCV-G8EUYkQTXvB_3OskTgIRg4oD61lF_68cnyOvZbO3MdrStvz0YfA

# Resend (https://resend.com) — collaborator invite emails from Share dialog
RESEND_API_KEY=
# Verified sender, e.g. Trace AI <invites@yourdomain.com> (dev: onboarding@resend.dev)
RESEND_FROM_EMAIL=
# Public app URL for invite links (production); optional locally (uses request host)
NEXT_PUBLIC_APP_URL=
